rules_version = '2';

// ============================================================================
// firestore.rules
// ----------------------------------------------------------------------------
// 管理画面(admin.html / Firebase Authログイン)を実装したため、
// 抽選結果の反映(drawn更新)・投稿の削除・レイアウト/画像設定の変更は
// すべて「ログイン済みの管理者」のみが実行できるように締めています。
//
// 配信画面(index.html)・投稿画面(post.html)は非ログインのままで、
// 閲覧(read)と、視聴者投稿(create)のみ引き続き誰でも可能です。
//
// Firebaseコンソール → Firestore Database → ルール タブに、このファイルの
// 内容を貼り付けて「公開」してください。
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    match /gacha_posts/{postId} {

      // 読み取り：配信画面がカプセルの中身を表示するために必要。誰でも閲覧可。
      allow read: if true;

      // 作成：視聴者の投稿（ログイン不要）。項目の型と値を検証する。
      allow create: if
        request.resource.data.keys().hasOnly(['text', 'color', 'createdAt', 'drawn']) &&
        request.resource.data.text is string &&
        request.resource.data.text.size() > 0 &&
        request.resource.data.text.size() <= 60 &&
        request.resource.data.color in ['gold', 'silver', 'bronze'] &&
        request.resource.data.drawn == false;

      // 更新：抽選結果の反映(drawn:true)。管理画面からログイン済みの管理者のみ実行可能。
      allow update: if request.auth != null;

      // 削除：抽選済み投稿の整理・50件超過分のFIFO削除。管理者のみ実行可能。
      allow delete: if request.auth != null;
    }

    // 抽選イベント・リセット指示など、管理画面→配信画面への「合図」に使う。
    // 配信画面(index.html)はここをリアルタイム購読して演出を再生する。
    match /gacha_state/{stateId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // レイアウト設定・登録画像（本体/ハンドル等）。管理画面から保存する。
    match /gacha_settings/{settingId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
